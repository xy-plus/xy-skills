[Unit]
Description=Delete expired and unused temporary items

[Service]
Type=oneshot
# The configured entry reads RUNS_ROOT, builds its literal three-level patterns,
# and requires the preview marker before starting delete mode.
ExecStart=/usr/bin/python3 "%h/xy-skills/xy-runs/scheduled_cleanup/clean.py" configured --mode delete --additional-root "%h/.codex-subagent*/sessions/*/*"
StandardOutput=journal
StandardError=journal
